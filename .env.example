# Backend configuration
# Local MongoDB (via docker-compose): mongodb://localhost:27017
# Atlas free tier: mongodb+srv://<user>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=analytics

# CORS: allowed frontend origin(s). Comma-separate multiple origins to
# allow local dev and a deployed frontend at once, e.g.:
# FRONTEND_ORIGIN=http://localhost:5173,https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Frontend configuration (consumed by Vite, must be prefixed VITE_)
VITE_API_BASE_URL=http://localhost:8000

# Auth (role-based access control, see backend/app/security.py). The
# backend runs with an INSECURE built-in default if this is left unset
# — fine for local dev, never acceptable beyond it. Generate a real one
# with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# On-demand anomaly explanations (POST /api/anomalies/{id}/explain).
# Free key from Google AI Studio (https://aistudio.google.com/apikey),
# no credit card required. Optional: leave it empty and everything else
# works; only that one endpoint answers 503 until a key is set.
GEMINI_API_KEY=
# Configurable because hosted model names get retired (gemini-2.0-flash-lite already was).
GEMINI_MODEL=gemini-3.5-flash-lite

# Used only by backend/seed_users.py (never read by the running app) to
# create the first admin account and one business account per brand
# without hardcoding credentials into the script. Not committed with
# real values — this file is a template.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_BUSINESS_PASSWORD=
