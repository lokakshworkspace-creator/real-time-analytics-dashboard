# Backend configuration
# Local MongoDB (via docker-compose): mongodb://localhost:27017
# Atlas free tier: mongodb+srv://<user>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=analytics

# CORS: allowed frontend origin(s). Comma-separate multiple origins to
# allow local dev and a deployed frontend at once, e.g.:
# FRONTEND_ORIGIN=http://localhost:5173,https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Frontend configuration (consumed by Vite, must be prefixed VITE_)
VITE_API_BASE_URL=http://localhost:8000
